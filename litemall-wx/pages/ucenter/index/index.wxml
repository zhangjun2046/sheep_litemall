<view class="container">
  <view class="profile" bindtap="goLogin">
    <image class="avatar" src="/static/images/avatar.png" mode="aspectFill"></image>
    <view class="profile-text">
      <text class="name">{{userInfo.nickName}}</text>
      <text class="phone" wx:if="{{mobile}}">{{mobile}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-head" bindtap="goOrder">
      <text class="card-title">我的订单</text>
      <van-icon name="arrow" color="#c8c8c8" size="32rpx" />
    </view>
    <view class="grid grid-4">
      <view class="item" bindtap="goOrderIndex" data-index="1" data-route="/pages/ucenter/order/order">
        <text class="badge" wx:if="{{order.unpaid != 0}}">{{order.unpaid}}</text>
        <image src="/static/images/pendpay.png"></image>
        <text>待付款</text>
      </view>
      <view class="item" bindtap="goOrderIndex" data-index="2" data-route="/pages/ucenter/order/order">
        <text class="badge" wx:if="{{order.unship != 0}}">{{order.unship}}</text>
        <image src="/static/images/send.png"></image>
        <text>待发货</text>
      </view>
      <view class="item" bindtap="goOrderIndex" data-index="3" data-route="/pages/ucenter/order/order">
        <text class="badge" wx:if="{{order.unrecv != 0}}">{{order.unrecv}}</text>
        <image src="/static/images/receive.png"></image>
        <text>待收货</text>
      </view>
      <view class="item" bindtap="goOrderIndex" data-index="4" data-route="/pages/ucenter/order/order">
        <text class="badge" wx:if="{{order.uncomment != 0}}">{{order.uncomment}}</text>
        <image src="/static/images/comment.png"></image>
        <text>待评价</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">更多服务</text>
    </view>
    <view class="grid grid-4">
      <view class="item" bindtap="goCollect">
        <image src="/static/images/collect.png"></image>
        <text>收藏夹</text>
      </view>
      <view class="item" bindtap="goFootprint">
        <image src="/static/images/footprint.png"></image>
        <text>浏览足迹</text>
      </view>
      <view class="item" bindtap="goAddress">
        <image src="/static/images/address.png"></image>
        <text>地址管理</text>
      </view>
      <button class="item" open-type="getPhoneNumber" bindgetphonenumber="bindPhoneNumber">
        <image src="/static/images/mobile.png"></image>
        <text>绑定手机</text>
      </button>
      <view class="item" bindtap="goFeedback">
        <image src="/static/images/feedback.png"></image>
        <text>意见反馈</text>
      </view>
      <button class="item" open-type="contact" session-from="weapp">
        <image src="/static/images/customer.png"></image>
        <text>联系客服</text>
      </button>
      <view class="item" bindtap="aboutUs">
        <image src="/static/images/about.png"></image>
        <text>关于我们</text>
      </view>
      <view class="item" bindtap="goPrivacy">
        <image src="/static/images/help.png"></image>
        <text>隐私协议</text>
      </view>
    </view>
  </view>

  <view class="logout" wx:if="{{hasLogin}}" bindtap="exitLogin">退出登录</view>
</view>

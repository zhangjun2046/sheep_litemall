page {
  background: #fafafa;
}

.container {
  min-height: 100%;
  background: #fafafa;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.profile {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 32rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.profile-text {
  margin-left: 24rpx;
  min-width: 0;
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 48rpx;
  color: #222;
}

.phone {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #888;
}

.card {
  margin: 0 24rpx 24rpx;
  padding-bottom: 8rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 28rpx 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
  color: #222;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-4 .item {
  width: 25%;
}

.item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  margin: 0;
  padding: 20rpx 0 24rpx;
  background: #fff;
  border: none;
  border-radius: 0;
  line-height: normal;
  box-sizing: border-box;
}

.item::after {
  border: none;
}

.item image {
  width: 48rpx;
  height: 48rpx;
}

.item text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #333;
}

.item .badge {
  position: absolute;
  top: 8rpx;
  left: 50%;
  z-index: 1;
  min-width: 28rpx;
  height: 28rpx;
  margin-top: 0;
  margin-left: 8rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #b4282d;
  color: #fff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.logout {
  margin: 72rpx 24rpx 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  color: #b4282d;
  font-size: 28rpx;
}

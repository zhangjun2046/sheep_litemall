page {
  height: 100%;
  width: 100%;
  background: #f4f4f4;
}

.container {
  height: 100%;
  width: 100%;
}

.address-list {
  padding-left: 31.25rpx;
  background: #fff;
  background-size: auto 10.5rpx;
  margin-bottom: calc(136rpx + constant(safe-area-inset-bottom));
  margin-bottom: calc(136rpx + env(safe-area-inset-bottom));
}

.address-list .item {
  min-height: 156.55rpx;
  height: auto;
  align-items: center;
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #dcd9d9;
}

.address-list .l {
  width: 125rpx;
  height: auto;
  flex-shrink: 0;
  overflow: visible;
}

.address-list .name {
  width: 125rpx;
  height: auto;
  font-size: 29rpx;
  line-height: 40rpx;
  color: #333;
  margin-bottom: 5.2rpx;
  white-space: normal;
  word-break: break-all;
}

.address-list .default {
  width: 62.5rpx;
  height: 33rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b4282d;
  border: 1rpx solid #b4282d;
  visibility: visible;
}

.address-list .c {
  flex: 1;
  height: auto;
  min-width: 0;
  padding-right: 12rpx;
  overflow: visible;
}

.address-list .mobile {
  height: auto;
  font-size: 29rpx;
  line-height: 40rpx;
  color: #333;
  margin-bottom: 6.25rpx;
  white-space: normal;
  word-break: break-all;
}

.address-list .address {
  height: auto;
  font-size: 25rpx;
  line-height: 37rpx;
  color: #666;
  white-space: normal;
  word-break: break-all;
}

.address-list .r {
  width: 52rpx;
  height: auto;
  overflow: hidden;
  margin-right: 16.5rpx;
}

.address-list .del {
  display: block;
  width: 52rpx;
  height: 52rpx;
}

.address-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #f4f4f4;
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.bar-btn.plain {
  margin-right: 20rpx;
  color: #ab956d;
  background: #fff;
  border: 1rpx solid #ab956d;
}

.bar-btn.solid {
  color: #f4f4f4;
  background: #ab956d;
}

.empty-view {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-view .text {
  width: auto;
  font-size: 28rpx;
  line-height: 35rpx;
  color: #999;
}

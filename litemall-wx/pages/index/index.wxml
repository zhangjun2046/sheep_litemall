<!-- index.wxml -->
<view class="container">
    <view class="search">
        <navigator url="/pages/search/search" class="input">
            <van-icon name="search" />
            <text class="txt">商品搜索, 共{{goodsCount}}款好物</text>
        </navigator>
    </view>
    <swiper class="banner" indicator-dots="true" autoplay="true" interval="3000" duration="1000">
        <swiper-item wx:for="{{banner}}" wx:key="id">
            <block wx:if="{{item.link>0}}">
                <navigator url="/pages/goods/goods?id={{item.link}}">
                    <image src="{{item.url}}" mode="aspectFill" binderror="onImageError" data-src="{{item.url}}"></image>
                </navigator>
            </block>
            <block wx:else>
                <image src="{{item.url}}" mode="aspectFill" binderror="onImageError" data-src="{{item.url}}"></image>
            </block>
        </swiper-item>
    </swiper>
    <view class="a-section a-popular" wx:if="{{hotGoods.length > 0}}">
        <view class="b">
            <view class="item" wx:for="{{hotGoods}}" wx:for-index="index" wx:for-item="item" wx:key="id">
                <navigator url="/pages/goods/goods?id={{item.id}}">
                    <image class="img" src="{{item.picUrl}}" mode="aspectFill" binderror="onImageError" data-src="{{item.picUrl}}"></image>
                    <view class="right">
                        <view class="text">
                            <text class="name">{{item.name}}</text>
                            <text class="desc">{{item.brief}}</text>
                            <text class="price">￥{{item.retailPrice}}</text>
                        </view>
                    </view>
                </navigator>
            </view>
        </view>
    </view>
</view>

<view class="container">
  <view class="search">
    <navigator url="/pages/search/search" class="input">
      <van-icon name="search" />
      <text class="txt">商品搜索, 共{{goodsCount}}款好物</text>
    </navigator>
  </view>
  <swiper class="banner" style="height: {{bannerHeight}}rpx" indicator-dots autoplay interval="3000" duration="1000">
    <swiper-item wx:for="{{banner}}" wx:key="id">
      <image src="{{item.url}}" mode="aspectFill" style="height: {{bannerHeight}}rpx" bindtap="onBannerTap" data-link="{{item.link}}" binderror="onImageError" data-src="{{item.url}}"></image>
    </swiper-item>
  </swiper>
  <view class="goods" wx:if="{{goodsLoading && hotGoods.length === 0}}">
    <view class="goods-item" wx:for="{{skeletonList}}" wx:key="*this">
      <view class="skeleton-img"></view>
      <view class="skeleton-price"></view>
    </view>
  </view>
  <view class="goods" wx:elif="{{hotGoods.length > 0}}">
    <navigator class="goods-item" wx:for="{{hotGoods}}" wx:key="id" url="/pages/goods/goods?id={{item.id}}" hover-class="none">
      <image class="img" src="{{item.picUrl}}" mode="widthFix" binderror="onImageError" data-src="{{item.picUrl}}"></image>
      <view class="price">
        <text class="symbol">￥</text>
        <text class="val">{{item.retailPrice}}</text>
      </view>
    </navigator>
  </view>
</view>

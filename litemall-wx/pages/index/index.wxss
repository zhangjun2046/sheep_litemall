.container {
  background: #f0f0f0;
}

.search {
  height: 88rpx;
  padding: 0 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
}

.search .van-icon-search {
  line-height: 65rpx;
}

.search .input {
  width: 690rpx;
  height: 65rpx;
  background: #ededed;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search .txt {
  height: 42rpx;
  line-height: 42rpx;
  color: #666;
  padding-left: 10rpx;
  font-size: 30rpx;
}

.banner {
  width: 710rpx;
  margin: 10rpx 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.banner image {
  width: 100%;
  border-radius: 12rpx;
}

.goods {
  margin-top: 24rpx;
  padding-bottom: 8rpx;
}

.goods-item {
  display: block;
  width: 702rpx;
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
}

.goods-item .img {
  width: 100%;
  min-height: 702rpx;
  background: #f4f4f4;
  display: block;
  width: 100%;
  height: auto;
  border-radius: 28rpx 28rpx 0 0;
}

.price {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding: 8rpx 30rpx 30rpx;
  color: #d81e06;
  font-family: "DIN Alternate", -apple-system, sans-serif;
  font-weight: bold;
}

.price .symbol {
  font-size: 26rpx;
  margin-right: 4rpx;
}

.price .val {
  font-size: 40rpx;
  line-height: 1;
}

.skeleton-img {
  height: 702rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: linear-gradient(90deg, #ececec 25%, #f7f7f7 37%, #ececec 63%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

.skeleton-price {
  width: 120rpx;
  height: 32rpx;
  margin: 20rpx 24rpx 24rpx auto;
  border-radius: 8rpx;
  background: #ececec;
}

@keyframes skeleton-shine {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}

/* about.wxss */

page {
  background: #f4f4f4;
}

.brand-info {
  width: 100%;
  margin-bottom: 10rpx;
}

.brand-info .name {
  width: 100%;
  height: 290rpx;
  position: relative;
}

.brand-info .img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 290rpx;
}

.brand-info .desc {
  background: #fff;
  width: 100%;
  height: auto;
  overflow: hidden;
  padding: 41.5rpx 31.25rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #666;
  line-height: 41.5rpx;
  text-align: center;
}

.label {
  font-size: 26rpx;
  margin-left: 20rpx;
  padding: 10rpx 0;
} 


.about-item{
  background: white;
  border-top: solid #f2f2f2 0.5rpx;
  border-bottom: solid #f2f2f2 0.5rpx;
  width: 100%;
  min-height: 100rpx;
  height: auto;
  padding: 16rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.item-left{
  font-size: 32rpx;
  margin-left: 40rpx;
  margin-right: 20rpx;
  margin-top: auto;
  margin-bottom: auto;
  word-break: break-all;
  flex: 1;
}

.item-right{
  margin-right: 15rpx;
  margin-top: auto;
  margin-bottom: auto;
}
.right-icon{
  width: 40rpx;
  height: 40rpx;
}
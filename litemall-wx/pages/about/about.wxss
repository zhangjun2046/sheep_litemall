page {
  background: #f4f4f4;
}

.container {
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero {
  height: 360rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 360rpx;
}

.intro {
  margin: 24rpx 24rpx 0;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
}

.intro-text {
  display: block;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #666;
  text-align: center;
}

.card {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.card-title {
  padding: 28rpx 28rpx 8rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f3f3f3;
}

.row-last {
  border-bottom: none;
}

.icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f8f1ea;
}

.row-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  margin-right: 16rpx;
}

.row-label {
  display: block;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #999;
}

.row-value {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #333;
  word-break: break-all;
}

.row-action {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #b4282d;
}

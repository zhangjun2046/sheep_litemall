<view class="container">
  <view class="hero" wx:if="{{picUrl}}">
    <image class="hero-img" src="{{picUrl}}" mode="aspectFill"></image>
  </view>

  <view class="intro" wx:if="{{desc}}">
    <text class="intro-text">{{desc}}</text>
  </view>

  <view class="card">
    <view class="card-title">联系方式</view>
    <view class="row" bindtap="copyAddress">
      <view class="icon-wrap">
        <van-icon name="location-o" color="#b4282d" size="34rpx" />
      </view>
      <view class="row-main">
        <text class="row-label">公司地址</text>
        <text class="row-value">{{address}}</text>
      </view>
      <text class="row-action">复制</text>
    </view>
    <view class="row" bindtap="callPhone">
      <view class="icon-wrap">
        <van-icon name="phone-o" color="#b4282d" size="34rpx" />
      </view>
      <view class="row-main">
        <text class="row-label">电话号码</text>
        <text class="row-value">{{phone}}</text>
      </view>
      <text class="row-action">拨打</text>
    </view>
    <view class="row row-last" bindtap="copyQQ">
      <view class="icon-wrap">
        <van-icon name="friends-o" color="#b4282d" size="34rpx" />
      </view>
      <view class="row-main">
        <text class="row-label">QQ交流群</text>
        <text class="row-value">{{qq}}</text>
      </view>
      <text class="row-action">复制</text>
    </view>
  </view>
</view>

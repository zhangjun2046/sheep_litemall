.login-box {
  width: 100%;
  height: auto;
  overflow: hidden;
  padding: 0 40rpx;
  margin-top: 200rpx;
  background: #fff;
}

.wx-login-btn {
  margin: 60rpx 5% 40rpx;
  width: 90%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: #fff;
  background: #ab956d;
  border: none;
  border-radius: 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn-hover {
  background: #9a855e;
  color: #fff;
}

.agreement-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.agreement-label {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.agreement-check {
  transform: scale(0.72);
  margin-right: 4rpx;
}

.agreement-link {
  color: #576b95;
}

.account-login-btn {
  width: 90%;
  margin: 0 auto;
  margin-left: 5%;
  color: #fff;
  font-size: 30rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  text-align: center;
  letter-spacing: 3rpx;
  border-radius: 48rpx;
  background: #9a9ba1;
}

.account-login-btn::after {
  border: none;
}

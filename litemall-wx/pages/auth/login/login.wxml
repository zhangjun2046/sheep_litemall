<view class="container">
  <view class="login-box">
    <button wx:if="{{canIUseGetUserProfile}}" class="wx-login-btn" hover-class="wx-login-btn-hover" bindtap="wxLogin">微信直接登录</button>
    <button wx:else class="wx-login-btn" hover-class="wx-login-btn-hover" open-type="getUserInfo" bindgetuserinfo="wxLogin">微信直接登录</button>
    <!-- <button class="account-login-btn" bindtap="accountLogin">账号登录</button> -->
    <view class="agreement-tip">
      <checkbox-group bindchange="onAgreeChange">
        <label class="agreement-label">
          <checkbox class="agreement-check" value="1" checked="{{agreed}}" color="#ab956d" />
          <text>我已阅读并同意</text>
          <text class="agreement-link" catchtap="goAgreement" data-tab="user">《用户协议》</text>
          <text>和</text>
          <text class="agreement-link" catchtap="goAgreement" data-tab="privacy">《隐私政策》</text>
        </label>
      </checkbox-group>
    </view>
  </view>
</view>